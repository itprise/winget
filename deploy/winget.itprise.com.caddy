# Site block for the winget source (rewinged on 127.0.0.1:8080).
# Install as /etc/caddy/sites-enabled/winget.itprise.com.caddy - the main
# Caddyfile imports /etc/caddy/sites-enabled/*.caddy.
# No `tls` directive on purpose: no certificate was supplied for this host,
# so Caddy obtains one via ACME (ports 80 + 443 must be reachable).
winget.itprise.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}
