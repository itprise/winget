[Unit]
Description=rewinged - winget REST source for ITPrise
After=network-online.target
Wants=network-online.target

[Service]
User=rewinged
Group=rewinged
ExecStart=/opt/rewinged/rewinged -listen 127.0.0.1:8080 -trustedProxies 127.0.0.1 -manifestPath /var/lib/rewinged/repo/manifests -logLevel info
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/rewinged

[Install]
WantedBy=multi-user.target
